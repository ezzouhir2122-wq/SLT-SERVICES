# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Administration : à configurer dans Vercel > Settings > Environment Variables.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_WITH_A_LONG_UNIQUE_PASSWORD"
ADMIN_API_TOKEN="CHANGE_ME_WITH_A_LONG_RANDOM_TOKEN"

# Persistance de production (Supabase).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------
# SUPABASE (persistance serveur)
# Si ces deux variables sont définies, server.ts stocke dans Supabase ;
# sinon il retombe automatiquement sur la base fichier data/db.json.
# La clé service_role est SECRÈTE : serveur uniquement, jamais exposée au front.
# Dashboard Supabase > Project Settings > API
# ------------------------------------------------------------------
SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ------------------------------------------------------------------
# NOTIFICATION EMAIL DES LEADS (Resend)
# Si RESEND_API_KEY et LEAD_NOTIFY_EMAIL sont définis, un email est envoyé
# au gérant à chaque nouveau devis. Sinon, fonctionnalité désactivée (no-op).
# Clé API : https://resend.com/api-keys
# LEAD_NOTIFY_FROM doit utiliser un domaine vérifié dans Resend
# (ou laisser onboarding@resend.dev pour tester vers votre propre email).
# ------------------------------------------------------------------
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL="contact@slt-services.ma"
LEAD_NOTIFY_FROM="SLT SERVICES <onboarding@resend.dev>"

# ------------------------------------------------------------------
# SEO / Frontend
# URL de production officielle (canonical, sitemap, Open Graph).
# Injectée au build par Vite (préfixe VITE_ obligatoire côté client).
# ------------------------------------------------------------------
VITE_SITE_URL="https://slt-services.vercel.app"
